# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app (http://localhost:3000 locally, the Vercel URL in production)
APP_URL=

# Supabase (new project, per PRD p10 §15)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Payments (test mode). Stripe, or Razorpay if Stripe signup is unavailable — see docs/DECISIONS.md D-01
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Protects /api/cron/* endpoints (Vercel cron sends it as a Bearer token)
CRON_SECRET=
