# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app (http://localhost:3000 locally, the Vercel URL in production)
APP_URL=

# Supabase (new project, per PRD p10 §15)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key. Server-only: never expose to the browser.
SUPABASE_SECRET_KEY=

# Payments (Stripe, test mode). Razorpay variables are unused placeholders — see docs/DECISIONS.md D-01
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Test accounts created by `pnpm seed:users` (use strong passwords outside local dev)
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Protects /api/cron/* endpoints (Vercel cron sends it as a Bearer token)
CRON_SECRET=
